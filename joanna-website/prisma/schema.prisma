generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

enum Section {
  WORK
  TRAVEL
  BOOKS
  CURRENT
  TIW
  RECOMMENDATIONS
}

model Post {
  id        String      @id @default(cuid())
  title     String
  subtitle  String
  slug      String      @unique
  section   Section
  body      String
  published Boolean     @default(true)
  createdAt DateTime    @default(now())
  images    PostImage[]
}

model PostImage {
  id      String @id @default(cuid())
  url     String
  altText String?
  order   Int    @default(0)
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
}